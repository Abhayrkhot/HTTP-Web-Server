# systemd unit with sandboxing. Pair with hws.socket for zero-downtime restarts: systemd owns the
# listening socket, so connections queue in the kernel while the process restarts instead of
# being refused.
#
#   install -m755 build/hws /usr/local/bin/hws
#   install -Dm644 deploy/hws.conf /etc/hws/hws.conf
#   cp deploy/hws.service deploy/hws.socket /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now hws.socket hws.service
[Unit]
Description=hws HTTP server
Documentation=https://github.com/Abhayrkhot/HTTP-Web-Server
After=network-online.target
Wants=network-online.target
Requires=hws.socket

[Service]
Type=exec
ExecStart=/usr/local/bin/hws --config /etc/hws/hws.conf
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=35
Restart=on-failure
RestartSec=1

LimitNOFILE=1048576
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
ReadOnlyPaths=/srv/www

[Install]
WantedBy=multi-user.target
